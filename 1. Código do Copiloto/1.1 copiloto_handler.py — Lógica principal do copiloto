# src/copiloto/copiloto_handler.py

import requests
import logging

# Configuração de logger para captura de logs
logger = logging.getLogger(__name__)
logger.setLevel(logging.INFO)

class Copiloto:
    def __init__(self, api_key: str):
        self.api_key = api_key

    def realizar_tarefa(self, tarefa: str):
        if tarefa == "enviar_email":
            self.enviar_email()
        elif tarefa == "agendar_reuniao":
            self.agendar_reuniao()
        else:
            logger.error(f"Tarefa desconhecida: {tarefa}")

    def enviar_email(self):
        # Lógica para enviar um email
        try:
            # Exemplo de integração com uma API de e-mail (substitua com uma API real)
            response = requests.post("https://api.email.com/send", data={"api_key": self.api_key})
            if response.status_code == 200:
                logger.info("Email enviado com sucesso!")
            else:
                logger.error(f"Erro ao enviar email: {response.text}")
        except Exception as e:
            logger.error(f"Erro ao tentar enviar email: {str(e)}")

    def agendar_reuniao(self):
        # Lógica para agendar uma reunião (exemplo fictício)
        try:
            response = requests.post("https://api.calendar.com/schedule", data={"api_key": self.api_key})
            if response.status_code == 200:
                logger.info("Reunião agendada com sucesso!")
            else:
                logger.error(f"Erro ao agendar reunião: {response.text}")
        except Exception as e:
            logger.error(f"Erro ao tentar agendar reunião: {str(e)}")
